# GNOMAN Environment Configuration Template
# Copy this file to .env and customize for your setup

# Ethereum RPC URL
# Use local node, Infura, Alchemy, or other RPC provider
ETH_RPC_URL=http://localhost:8545

# Chain ID
# 1 = Ethereum Mainnet
# 5 = Goerli Testnet
# 11155111 = Sepolia Testnet
# 137 = Polygon
# 42161 = Arbitrum One
CHAIN_ID=1

# Network Name (for display purposes)
NETWORK_NAME=mainnet

# Optional: Custom keyring service name
# KEYRING_SERVICE=GNOMAN

# Optional: Audit log configuration
# AUDIT_ENABLED=true
# AUDIT_LOG_DIR=~/.gnoman/audit_logs

# Optional: ABI cache directory
# ABI_CACHE_DIR=~/.gnoman/abi_cache
